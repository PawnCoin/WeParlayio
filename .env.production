# WeParlay.io Production Environment Configuration
# Copy these values to your deployment environment

# SSL Configuration
NODE_ENV=production
SSL_ENABLED=true
DOMAIN=weparlay.io
REDIRECT_HTTP=true
HTTPS_PORT=443

# SSL Certificate Paths (auto-set by Let's Encrypt)
SSL_CERT_PATH=/etc/letsencrypt/live/weparlay.io/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/weparlay.io/privkey.pem

# Database (keep your existing DATABASE_URL)
# DATABASE_URL=your_existing_database_url

# WeParlay Configuration
REPLIT_DOMAINS=weparlay.io,www.weparlay.io
SESSION_SECRET=your_session_secret_here

# API Keys (add your existing keys)
# THE_ODDS_API_KEY=your_existing_key
# STRIPE_SECRET_KEY=your_existing_key
# VITE_STRIPE_PUBLIC_KEY=your_existing_key
# Add other existing API keys...