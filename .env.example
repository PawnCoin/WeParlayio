# PostgreSQL connection supplied by Neon, Replit PostgreSQL, or another host.
# Keep SSL enabled for hosted databases. Never commit the real value.
DATABASE_URL=postgresql://username:password@hostname:5432/weparlay?sslmode=require

# Private server-to-server key used by the verified tournament settlement job.
# Generate at least 32 random bytes. Never expose this as a VITE_ variable.
TOURNAMENT_SETTLEMENT_KEY=replace_with_a_long_random_secret

# Private key for the scheduled P2P result-verification job. This job queues
# corroborated finals only; it never pays out automatically.
P2P_SETTLEMENT_KEY=replace_with_a_different_long_random_secret

# Sports data API
THE_ODDS_API_KEY=your_odds_api_key_here

# Optional corroborating sports-results source. TheSportsDB's documented free
# key is useful for development; use your own key and provider-approved limits
# before enabling production result verification.
THESPORTSDB_API_KEY=your_thesportsdb_api_key

# Licensed production sports-result providers. Leave disabled until you supply
# a provider, contract-approved credentials, and its adapter is implemented.
SPORTS_RESULTS_PRIMARY_PROVIDER=
SPORTS_RESULTS_PRIMARY_API_KEY=
SPORTS_RESULTS_PRIMARY_ENABLED=false
SPORTS_RESULTS_SECONDARY_PROVIDER=
SPORTS_RESULTS_SECONDARY_API_KEY=
SPORTS_RESULTS_SECONDARY_ENABLED=false
RESULT_SYNC_INTERVAL_SECONDS=300

# Yahoo Fantasy integration
YAHOO_CLIENT_ID=your_yahoo_client_id_here
YAHOO_CLIENT_SECRET=your_yahoo_client_secret_here

# Social Media Integration
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# Facebook API Configuration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_long_lived_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# Instagram API credentials (get from Meta Business)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Session secret (generate a random string)
SESSION_SECRET=your_session_secret_here

# Public origin used in email and SMS invitation links.
PUBLIC_APP_URL=https://weparlay.io

# Transactional email provider (SMTP)
SMTP_USERNAME=your_transactional_email_username
SMTP_PASSWORD=your_transactional_email_password

# SMS is intentionally disabled until a provider confirms in writing that it
# supports WeParlay's licensed, age-gated, opt-in gambling messages in every
# intended jurisdiction. Do not add generic SMS provider credentials here.

# Environment
NODE_ENV=production

# Port (optional - defaults to 3000 in production)
PORT=3000
